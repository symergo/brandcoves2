# Files are authored on Windows but run in Linux containers. CRLF in a shell
# script, a Dockerfile or an entrypoint breaks the build in ways that are
# tedious to diagnose.
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.blade.php text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.dump binary
*.gz   binary

# Keep diffs and archives lean.
/.github            export-ignore
/tests              export-ignore
/docs               export-ignore
.editorconfig       export-ignore
.gitattributes      export-ignore
.gitignore          export-ignore
