#!/bin/sh
#
# Run the test suite before a push.
#
# Why here and not on every save: the suite is a 40-second parallel run against a
# real Postgres, which is too slow to sit in an edit loop and too important to
# skip. A push is the last moment the result is still cheap to act on — both
# `main` is the only branch: pushing it auto-deploys staging, and a
# fast-forward of `main` ships to production with no further gate.
#
# Install (once per clone):  git config core.hooksPath .githooks
# Bypass, deliberately:      git push --no-verify

# Nothing to test when the push only deletes a remote branch.
deleting_only=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
        deleting_only=0
    fi
done
[ "$deleting_only" -eq 1 ] && exit 0

printf '\033[0;34mpre-push:\033[0m running the test suite...\n'

# Postgres is the one dependency the suite cannot fake — the schema uses partial
# indexes, generated tsvector columns and pg_trgm. Say so plainly rather than
# letting the failure arrive as 894 connection errors.
if ! docker compose exec -T postgres pg_isready -U brandcoves >/dev/null 2>&1; then
    printf '\033[0;31mpre-push: postgres is not reachable.\033[0m Run: docker compose up -d\n'
    exit 1
fi

# Find PHP by running it, not by looking it up.
#
# Herd on Windows installs `php.bat`, which is not marked executable, and Git
# runs this hook under its own bundled `sh`. That shell will happily *execute*
# `php.bat` but `command -v php.bat` reports nothing, because it only considers
# files with the executable bit — so a lookup-based probe concludes PHP is
# missing on a machine where it plainly works. The bare name `php` finds nothing
# either, since sh does not append Windows executable extensions.
#
# Left unhandled the hook aborted every push on a Windows clone with "php:
# command not found" under a banner reading "tests failed" — the one thing it
# must never claim when the suite has not run at all. Probing by invocation
# costs one process and is the only check that agrees with reality.
PHP=
for candidate in php php.bat; do
    if "$candidate" -v >/dev/null 2>&1; then
        PHP=$candidate
        break
    fi
done

if [ -z "$PHP" ]; then
    printf '\033[0;31mpre-push: no working php found.\033[0m The suite did NOT run.\n'
    exit 1
fi

# A failed parallel run is not proof of a failing test.
#
# Measured on 2026-08-29: under a real `git push`, ParaTest prints its banner and
# exits 127 — command not found — having run zero tests. The same command passes
# from a shell, under Git's `sh`, under this hook invoked by hand, and under
# `git push --dry-run`. The hook's environment on a real push is byte-identical
# to the dry-run's, `PHP_BINARY` resolves, and two workers on one test file are
# fine; it only fails spawning eight workers for the full suite. Whatever the
# cause, it happens before the first test runs.
#
# It was reported as "tests failed — push aborted", which is the one thing this
# hook must never say when the suite has not run. It blocked five pushes of a
# commit whose suite was green.
#
# So a failed parallel run is re-run serially and the serial result decides. That
# cannot weaken the gate: a genuinely broken test fails both ways and the push
# still aborts. It can only turn a false abort into a pass. The extra time is
# spent only on a run that was going to abort anyway — 150s rather than 40s, on
# the push you would have had to investigate by hand regardless.
if ! "$PHP" artisan test --parallel --processes=8; then
    printf '\033[0;33mpre-push: the parallel run failed — re-running serially to see whether a test is really broken...\033[0m\n'

    if ! "$PHP" artisan test; then
        printf '\033[0;31mpre-push: tests failed — push aborted.\033[0m\n'
        printf 'Fix them, or push with --no-verify if you know why this is fine.\n'
        exit 1
    fi

    printf '\033[0;33mpre-push: the serial run passed.\033[0m The parallel runner crashed rather than\n'
    printf 'finding a broken test — see the comment in .githooks/pre-push. Allowing the push.\n'
fi

exit 0
