APP_NAME=GiftCoves
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Laravel's own locale, used for framework strings. The SITE markets are a
# separate concept entirely — see config/markets.php.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_BE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------- database ---
# Matches the postgres service in docker-compose.yml.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=brandcoves
DB_USERNAME=brandcoves
DB_PASSWORD=brandcoves

# Deployment only, and easy to miss because nothing local reads them.
#
# docker-compose.coolify.yml runs its own postgres container and these three
# initialise it, while DB_* above tell Laravel how to connect. On a deployed
# environment both halves must agree or the app authenticates against a database
# that was created with different credentials. Left unset in Coolify they
# interpolate to empty strings and postgres refuses to initialise at all.
POSTGRES_DB=brandcoves
POSTGRES_USER=brandcoves
POSTGRES_PASSWORD=

# ------------------------------------------------------------------ redis ---
# predis, not phpredis: the phpredis extension has no Windows build, and the
# whole point of the host-dev setup is that it works on this laptop.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis-backed so Horizon can see the queues. Ingestion, grouping, scoring,
# daily picks and guide building all run here — never in a web request.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ------------------------------------------------------------------- mail ---
# Dev goes to Mailpit: http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@giftcoves.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production sends over OVH's Zimbra SMTP, not Resend. Set in Coolify:
#
#   MAIL_MAILER=smtp
#   MAIL_HOST=ssl0.ovh.net        (smtp.mail.ovh.net also works)
#   MAIL_PORT=465
#   MAIL_SCHEME=smtps             — 465 is implicit TLS. A blank scheme makes
#                                   Laravel try STARTTLS, which fails on 465
#                                   with an error that reads like a firewall.
#   MAIL_USERNAME=hello@giftcoves.com
#   MAIL_PASSWORD=<the mailbox password>
#   MAIL_FROM_ADDRESS=hello@giftcoves.com
#
# MAIL_FROM_ADDRESS must match MAIL_USERNAME: OVH rejects a From it has not
# authenticated. Verified working on 465 and 587, both hosts.
#
# Resend is kept switchable rather than removed, so falling back is an env
# change. Unused while MAIL_MAILER is smtp.
RESEND_API_KEY=

# ------------------------------------------------------------------- auth ---
# Optional: with no credentials the Google button hides itself and both routes
# 404, and the magic link still works. This exact URI must also be registered in
# the Google console for every environment — it is matched by exact string.
#
# No /{market}/ segment, unlike every other route. One registered URI instead of
# five per environment; the market crosses the round-trip in the session. Adding
# a market here breaks sign-in. See docs/features/auth.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ---------------------------------------------------------------- secrets ---
# 32-byte base64 key for AES-256-GCM encryption of connector credentials at
# rest. Generate with: php artisan key:generate --show
CREDENTIALS_ENCRYPTION_KEY=

# Salt for the one-way wishlist claim hash. Changing this orphans every existing
# claim, so treat it as permanent.
CLAIM_HASH_SECRET=

# --------------------------------------------------------------------- ai ---
# AI is only ever called from a queued job, never from a request handler.
# With AI_ENABLED=false the site still works: curated daily-pick themes and
# template guide copy.
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------- connectors -------
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# A second Awin publisher account. An advertiser is only reachable through
# the account joined to them - Vanden Borre uses a different affiliate member
# id, and its feeds are absent from the primary account list entirely.
#
# The API token IS the account selector. `datafeed/list/apikey/{token}/` returns
# only the feeds of the account that minted the key, and the response carries no
# publisher column at all - so a second account needs a second key, generated
# from the Awin UI while signed in to it. The publisher id alone does nothing:
# it gates the admin feed picker and is absent from the download URL.
#
# In use: 375169 (primary), 571797 (second).
AWIN_VDB_API_TOKEN=
AWIN_VDB_PUBLISHER_ID=

BOL_CLIENT_ID=
BOL_CLIENT_SECRET=

# eBay Browse API. A PRODUCTION keyset: a sandbox one authenticates against a
# different host and sells test data. The connector is inert without both halves,
# so leaving these blank is safe.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# eBay Partner Network campaign ids, per marketplace. Missing means the links
# still work and earn nothing — prove them with bc:check-ebay.
EBAY_CAMPAIGN_ID_NL=
EBAY_CAMPAIGN_ID_FR=
EBAY_CAMPAIGN_ID_ES=

# eBay Marketplace Account Deletion — the compliance webhook, and the thing that
# makes the production keyset mint tokens at all. Without it eBay marks the
# application "non compliant" and every token request answers invalid_client.
#
# The token is one WE invent and paste into eBay's portal: 32-80 characters of
# [A-Za-z0-9_-]. Generate one with
#   php -r "echo substr(str_replace(['+','/','='],['-','_',''], base64_encode(random_bytes(36))), 0, 48);"
EBAY_DELETION_VERIFICATION_TOKEN=
# EXACTLY the URL registered with eBay — it is an input to the challenge hash,
# so www and non-www are different answers. Blank falls back to the request URL,
# which is right locally and a guess in production.
EBAY_DELETION_ENDPOINT=

# Tradedoubler Open Product API token, from the publisher interface. One value,
# not a pair: it is sent as a query parameter and it carries the affiliate id,
# so the links it returns are already tracked. Treat it as a payment credential
# — anybody holding it can attribute their own traffic to this account.
TRADEDOUBLER_TOKEN=

# Deferred to Phase 8 — the connector exists but stays off until the credentials
# are verified. Source: ../PAAPICredentials.csv and ../Amazon-tags.txt
AMAZON_ENABLED=false
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
# Comma-separated host=tag pairs, e.g. amazon.nl=brandcoves-21,amazon.fr=brandcoves0c-21
AMAZON_PARTNER_TAGS=

# The Associates tags behind the "search this on Amazon too" link in the search
# sidebar and on product pages. Separate from AMAZON_PARTNER_TAGS above and NOT
# gated on AMAZON_ENABLED: that flag governs the PA-API connector, which needs
# credentials and is still Phase 8, while this is one outbound anchor that works
# the moment the tag is known.
#
# Both have working defaults in config/giftcoves.php, so these only need setting
# to correct or rotate a tag. A tag is issued per marketplace — a .be tag on an
# amazon.nl URL tracks nothing, and Amazon reports no error for it — so the two
# are never interchangeable. Empty means that market shows no link at all, which
# is the correct behaviour: no link beats an untracked one.
AMAZON_TAG_NL=
AMAZON_TAG_BE=

# -------------------------------------------------------------------- ops ---
# The rename from Brandcoves. Both domains are attached to the same Coolify app,
# and RedirectLegacyHost 301s the old one to the same path on the new one.
# Leave BOTH empty anywhere that has not been cut over — a canonical host with no
# legacy hosts is harmless, but a legacy host with no canonical one redirects
# nowhere. Production only:
#   CANONICAL_HOST=giftcoves.com
#   LEGACY_HOSTS=brandcoves.com,www.brandcoves.com
CANONICAL_HOST=
LEGACY_HOSTS=

# Staging must stay out of the index. Production sets this to true.
ROBOTS_ALLOW=false
# Google Analytics 4. Public by nature, so config/giftcoves.php carries the real
# default; set this to an empty value to switch the tag off for an environment.
# It renders only where ROBOTS_ALLOW=true, so staging never reports.
GA_MEASUREMENT_ID=G-1D0Z7W35SG
# Injected by Coolify at build time; surfaced on /health.
GIT_COMMIT_SHA=dev

# The build arg GIT_COMMIT_SHA is baked from. Coolify sets SOURCE_COMMIT in the
# build environment on its own — you never set this by hand, here or in the
# Coolify UI — and docker-compose.coolify.yml passes it through to the
# Dockerfile, which declares it as a late ARG so it invalidates only the last
# three trivial layers rather than the whole image.
#
# Listed because it is empty locally and that is CORRECT: a `docker compose
# build` on a laptop has no Coolify, /health reports commit: null, and nothing
# is wrong. It is written down so the next person does not go looking for the
# value, and because ConfigContractTest requires every variable the compose file
# interpolates to be documented somewhere a human reads.
SOURCE_COMMIT=

# VITE_* is baked into the client bundle at BUILD time. In Coolify these must be
# ticked as "Build Variable", not left as plain runtime variables.
VITE_APP_NAME="${APP_NAME}"

# Server-side rendering, so crawlers get real HTML. Runs as its own container
# in production;  npm run dev:ssr locally.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
