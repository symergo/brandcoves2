# Worker mode (Octane): the app is booted once per worker and kept in memory
# between requests. Imported into the global options block of docker/Caddyfile
# when docker/entrypoint.sh sets GIFTCOVES_PHP_MODE=worker, which it does only
# when OCTANE_WORKERS is true. How to switch it on and off, and what to watch:
# docs/features/speed.md, "Worker mode".
#
# The env lines are what `php artisan octane:frankenphp` would pass. This file
# replaces that command so the Caddyfile around it (cache headers, access log)
# stays the one we wrote.
frankenphp {
	worker {
		file /app/public/frankenphp-worker.php
		# Each worker holds a booted app (roughly 60-100 MB). Four is a start
		# for a shared VPS, not a measurement; change it with OCTANE_WORKER_NUM.
		num {$OCTANE_WORKER_NUM:4}
		env APP_BASE_PATH /app
		env APP_PUBLIC_PATH /app/public
		env LARAVEL_OCTANE 1
		# A worker restarts after this many requests, so a slow leak (memory,
		# or state nobody found) cannot grow without end.
		env MAX_REQUESTS {$OCTANE_MAX_REQUESTS:500}
	}
}
