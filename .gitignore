/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
# The SSR bundle, for the same reason as /public/build above: it is Vite
# output, rebuilt by `npm run build` in the Docker frontend stage and copied
# from there into the `ssr` image. Committed, it was 3.3 MB of dead weight in
# the runtime image and — worse — a cache buster: regenerating it locally
# changed `COPY . .`, which re-ran dump-autoload, package:discover, event:cache
# and view:cache to ship a file nothing in that image reads.
/bootstrap/ssr
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Secrets - never commit. .env holds live Awin/bol/Anthropic credentials plus
# the claim-hash secret, which is effectively permanent (rotating it orphans
# every existing wishlist claim).
.env
.env.*
!.env.example

*.pem
*.ppk
*.key
# Amazon credentials currently sit unencrypted in the parent folder. They belong
# in .env / the Coolify UI, never in the repo.
PAAPICredentials.csv
Amazon-tags.txt

# Database dumps. A production dump contains real user emails and personal gift
# notes, and this repo lives inside a Synology-synced folder.
*.dump
*.sql
*.sql.gz

# Synology Drive
@eaDir/
.sync*

# Written into the Docker image at build time, never committed.
/BUILD_STAMP

# Coolify API tokens. A Coolify token can redeploy, read every environment
# variable and reassign domains on both applications, so it is closer to a
# server credential than an API key. Ignored by extension rather than by name so
# a second one cannot be added under a filename nobody thought to list.
.claude/*.api
.claude/*.token
.claude/secrets*

# Agent permission rules. Not a secret, but a capability grant: this file
# currently carries `Bash(ssh root@51.75.78.173:*)`, which hands any agent
# running in this clone a root shell on the box serving production. Shared,
# it becomes a standing grant on machines whose owner never chose it — and
# permission rules are per-person and per-machine anyway.
.claude/settings.json
.claude/settings.local.json

# Google OAuth client secrets, as downloaded from the Cloud console. The file
# carries a live `client_secret` for the sign-in flow, and its default filename
# is long and unmemorable enough that nobody reviewing a `git add .` would
# recognise it. Ignored by pattern rather than by name so the next download —
# which gets a different numeric prefix — is covered too.
client_secret_*.json
