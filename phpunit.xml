<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            The whole suite runs in one PHP process, so memory is cumulative:
            every test boots the app and the peak only ever rises. At PHP's
            128M default the suite died mid-run with "allowed memory size
            exhausted" — on a *different* test each time, which is what makes
            it look like a flaky test rather than a ceiling. The tests that
            assert a 404 render Symfony's HTML error page, which is the
            expensive part, and there are dozens of them.

            Raised rather than trimmed: the run is a fixed cost that grows with
            the test count, and the next test file would hit this again.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Tests run on real Postgres, not sqlite::memory:.

            Not a preference — the schema cannot run on SQLite at all. It uses
            partial indexes, CHECK constraints, num_nonnulls(), a tsvector
            generated column, pg_trgm and custom immutable SQL functions. Testing
            against a database that silently lacks all of that would verify
            nothing about what actually ships.

            Create it once:  docker compose exec postgres createdb -U brandcoves brandcoves_test
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="brandcoves_test"/>
        <env name="DB_USERNAME" value="brandcoves"/>
        <env name="DB_PASSWORD" value="brandcoves"/>
        <env name="DB_URL" value=""/>
        <!--
            No live connector credentials in the test run.

            `.env` holds real bol credentials, and nothing here overrode them, so
            `BolConnector::supports()` returned true and every search test folded
            in **live results from the real bol API**. The suite passed or failed
            on what a third party happened to be selling: SearchTest asserts "one
            card for this product" and got twenty-five, and the test proving a
            nonsense query returns nothing got twenty-three.

            It had been passing only because the token bucket was empty at the
            time. That is not a passing test, it is a coin toss — and it makes the
            catalogue assertions untestable on any machine with a populated .env.

            `BolConnectorTest` sets these itself and fakes the HTTP, which is how
            a connector test should work anyway.
        -->
        <!--
            No server-side rendering in tests.

            Inertia SSRs whenever something is listening on the SSR port, so the
            suite quietly rendered through whatever Node process happened to be
            running — including a stale bundle left over from a debugging
            session, which produced a French page carrying Dutch copy and a
            product page carrying the previous one's GTIN. Two "failures" that
            were entirely about the machine they ran on.

            Tests assert on the Inertia payload, which is the same either way.
            SSR itself is exercised by posting a page object to the bundle
            directly; see docs/features/sharing.md.
        -->
        <env name="INERTIA_SSR_ENABLED" value="false"/>
        <env name="BOL_CLIENT_ID" value=""/>
        <env name="BOL_CLIENT_SECRET" value=""/>
        <env name="AWIN_API_TOKEN" value=""/>
        <env name="AWIN_VDB_API_TOKEN" value=""/>
        <env name="CLAIM_HASH_SECRET" value="testing-claim-secret"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
