APP_NAME=Brandcoves
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Laravel's own locale, used for framework strings. The SITE markets are a
# separate concept entirely — see config/markets.php.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_BE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------- database ---
# Matches the postgres service in docker-compose.yml.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=brandcoves
DB_USERNAME=brandcoves
DB_PASSWORD=brandcoves

# ------------------------------------------------------------------ redis ---
# predis, not phpredis: the phpredis extension has no Windows build, and the
# whole point of the host-dev setup is that it works on this laptop.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis-backed so Horizon can see the queues. Ingestion, grouping, scoring,
# daily picks and guide building all run here — never in a web request.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ------------------------------------------------------------------- mail ---
# Dev goes to Mailpit: http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@brandcoves.com"
MAIL_FROM_NAME="${APP_NAME}"

# In production, swap MAIL_MAILER to resend and set the key.
RESEND_API_KEY=

# ------------------------------------------------------------------- auth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ---------------------------------------------------------------- secrets ---
# 32-byte base64 key for AES-256-GCM encryption of connector credentials at
# rest. Generate with: php artisan key:generate --show
CREDENTIALS_ENCRYPTION_KEY=

# Salt for the one-way wishlist claim hash. Changing this orphans every existing
# claim, so treat it as permanent.
CLAIM_HASH_SECRET=

# --------------------------------------------------------------------- ai ---
# AI is only ever called from a queued job, never from a request handler.
# With AI_ENABLED=false the site still works: curated daily-pick themes and
# template guide copy.
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------- connectors -------
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

BOL_CLIENT_ID=
BOL_CLIENT_SECRET=

# Deferred to Phase 8 — the connector exists but stays off until the credentials
# are verified. Source: ../PAAPICredentials.csv and ../Amazon-tags.txt
AMAZON_ENABLED=false
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
# Comma-separated host=tag pairs, e.g. amazon.nl=brandcoves-21,amazon.fr=brandcoves0c-21
AMAZON_PARTNER_TAGS=

# -------------------------------------------------------------------- ops ---
# Staging must stay out of the index. Production sets this to true.
ROBOTS_ALLOW=false
# Injected by Coolify at build time; surfaced on /health.
GIT_COMMIT_SHA=dev

# VITE_* is baked into the client bundle at BUILD time. In Coolify these must be
# ticked as "Build Variable", not left as plain runtime variables.
VITE_APP_NAME="${APP_NAME}"

# Server-side rendering, so crawlers get real HTML. Runs as its own container
# in production;  npm run dev:ssr locally.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
